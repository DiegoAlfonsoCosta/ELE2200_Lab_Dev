% styles/custom.sty
% ==================
% Custom style file for ELE2200 lab reports
% Do NOT put \documentclass or \begin{document} here

\ProvidesPackage{styles/custom}[2026/02/24 Custom lab style]

% Core math and symbols
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{mathtools}

% Units and numbers
\RequirePackage{siunitx}
\sisetup{
  detect-all,
  per-mode=symbol
}

% Graphics and figures
\RequirePackage{graphicx}
\RequirePackage{float}

% Tables
\RequirePackage{booktabs}
\RequirePackage{array}

% Page layout
\RequirePackage[margin=1in]{geometry}

% References (biblatex handled in main.tex)
\RequirePackage{csquotes}

% Custom environments (optional)
\RequirePackage{listings}
\RequirePackage{xcolor}
\lstset{
    language=Matlab,
    basicstyle=\ttfamily\small,
    keywordstyle=\color{blue},
    commentstyle=\color{green!60!black},
    stringstyle=\color{red},
    numbers=left,
    numberstyle=\tiny\color{gray},
    stepnumber=1,
    numbersep=8pt,
    backgroundcolor=\color{gray!10},
    showspaces=false,
    showstringspaces=false,
    showtabs=false,
    frame=single,
    tabsize=4,
    captionpos=b,
    breaklines=true,
    breakatwhitespace=false,
    escapeinside={\%*}{*)},
    morekeywords={matlab2tikz},
    literate={é}{{\'{e}}}1 {è}{{\`{e}}}1 {à}{{\`{a}}}1 {ç}{{\c{c}}}1 {ô}{{\^{o}}}1 {É}{{\'{E}}}1 {ê}{{\^{e}}}1 {û}{{\^{u}}}1 {î}{{\^{i}}}1 {ù}{{\`{u}}}1,
    inputencoding=utf8,
    extendedchars=true
}
